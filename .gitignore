**pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs & Media/Uploads
*.log
logs/
media/
uploads/

# Alembic & Database
alembic/versions/*.pyc
*.db
*.sqlite
*.sqlite3

# Caches & Test coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.cover

