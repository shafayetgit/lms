# =========================
# 🔐 ENV & SECRETS
# =========================
.env
.env.*
*.env
*.secret
*.key
*.bak
*.backup
env_backup

# Allow environment example & template files to be committed
!.env.example
!.env.*.example
!.env.template
!.env.*.template

