[
  {
    "name": "email_verification",
    "subject": "Verify your email",
    "content_type": "html",
    "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n        }\n        .container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f9f9f9;\n            border-radius: 8px;\n        }\n        .header {\n            background-color: #4CAF50;\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 8px 8px 0 0;\n        }\n        .content {\n            background-color: white;\n            padding: 30px;\n            border-radius: 0 0 8px 8px;\n        }\n        .otp-box {\n            background-color: #f0f0f0;\n            border: 2px solid #4CAF50;\n            padding: 15px;\n            text-align: center;\n            margin: 20px 0;\n            border-radius: 5px;\n        }\n        .otp-code {\n            font-size: 32px;\n            font-weight: bold;\n            color: #4CAF50;\n            letter-spacing: 2px;\n        }\n        .footer {\n            text-align: center;\n            padding: 20px;\n            font-size: 12px;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class='container'>\n        <div class='header'>\n            <h1>Email Verification</h1>\n        </div>\n        <div class='content'>\n            <p>Hello {{ user_name }},</p>\n            \n            <p>Thank you for creating an account with us! To verify your email address and activate your account, please use the verification code below:</p>\n            \n            <div class='otp-box'>\n                <p style='margin: 0; color: #666; font-size: 14px; margin-bottom: 10px;'>Your Verification Code</p>\n                <div class='otp-code'>{{ otp }}</div>\n            </div>\n            \n            <p><strong>Important:</strong></p>\n            <ul>\n                <li>This code will expire in 10 minutes</li>\n                <li>Do not share this code with anyone</li>\n                <li>If you didn't create this account, please ignore this email</li>\n            </ul>\n            \n            <p>If you have any questions, please contact our support team.</p>\n            \n            <p>Best regards,<br>LMS Team</p>\n        </div>\n        <div class='footer'>\n            <p>&copy; 2026 LMS. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
    "enabled": true
  },
  {
    "name": "password_reset",
    "subject": "Reset your password",
    "content_type": "html",
    "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n        }\n        .container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f9f9f9;\n            border-radius: 8px;\n        }\n        .header {\n            background-color: #FF9800;\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 8px 8px 0 0;\n        }\n        .content {\n            background-color: white;\n            padding: 30px;\n            border-radius: 0 0 8px 8px;\n        }\n        .otp-box {\n            background-color: #f0f0f0;\n            border: 2px solid #FF9800;\n            padding: 15px;\n            text-align: center;\n            margin: 20px 0;\n            border-radius: 5px;\n        }\n        .otp-code {\n            font-size: 32px;\n            font-weight: bold;\n            color: #FF9800;\n            letter-spacing: 2px;\n        }\n        .warning {\n            background-color: #fff3cd;\n            border: 1px solid #ffeeba;\n            color: #856404;\n            padding: 10px;\n            border-radius: 5px;\n            margin: 15px 0;\n        }\n        .footer {\n            text-align: center;\n            padding: 20px;\n            font-size: 12px;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class='container'>\n        <div class='header'>\n            <h1>Password Reset Request</h1>\n        </div>\n        <div class='content'>\n            <p>Hello {{ user_name }},</p>\n            \n            <p>We received a request to reset the password for your account. Use the verification code below to reset your password:</p>\n            \n            <div class='otp-box'>\n                <p style='margin: 0; color: #666; font-size: 14px; margin-bottom: 10px;'>Your Password Reset Code</p>\n                <div class='otp-code'>{{ otp }}</div>\n            </div>\n            \n            <div class='warning'>\n                <strong>Security Notice:</strong> This code will expire in 10 minutes. If you didn't request a password reset, your account is secure and you can ignore this email.\n            </div>\n            \n            <p><strong>Important:</strong></p>\n            <ul>\n                <li>Do not share this code with anyone</li>\n                <li>Our staff will never ask for this code</li>\n                <li>Use this code only to reset your password</li>\n                <li>If this wasn't you, please secure your account immediately</li>\n            </ul>\n            \n            <p>If you have any questions, please contact our support team.</p>\n            \n            <p>Best regards,<br>LMS Team</p>\n        </div>\n        <div class='footer'>\n            <p>&copy; 2026 LMS. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
    "enabled": true
  },
  {
    "name": "password_changed",
    "subject": "Password changed successfully",
    "content_type": "html",
    "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n        }\n        .container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f9f9f9;\n            border-radius: 8px;\n        }\n        .header {\n            background-color: #2196F3;\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 8px 8px 0 0;\n        }\n        .content {\n            background-color: white;\n            padding: 30px;\n            border-radius: 0 0 8px 8px;\n        }\n        .success-icon {\n            text-align: center;\n            font-size: 48px;\n            color: #4CAF50;\n            margin: 20px 0;\n        }\n        .footer {\n            text-align: center;\n            padding: 20px;\n            font-size: 12px;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class='container'>\n        <div class='header'>\n            <h1>Password Changed Successfully</h1>\n        </div>\n        <div class='content'>\n            <p>Hello {{ user_name }},</p>\n            \n            <div class='success-icon'>✓</div>\n            \n            <p>Your password has been successfully changed. Your account is now secure with the new password.</p>\n            \n            <p><strong>What to do:</strong></p>\n            <ul>\n                <li>Your new password is active immediately</li>\n                <li>You can log in with your new password</li>\n                <li>If you didn't make this change, please reset your password immediately</li>\n            </ul>\n            \n            <p>For security reasons, we recommend:</p>\n            <ul>\n                <li>Not sharing your password with anyone</li>\n                <li>Using a unique and strong password</li>\n                <li>Keeping your password confidential</li>\n            </ul>\n            \n            <p>If you have any questions or concerns, please contact our support team.</p>\n            \n            <p>Best regards,<br>LMS Team</p>\n        </div>\n        <div class='footer'>\n            <p>&copy; 2026 LMS. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
    "enabled": true
  },
  {
    "name": "welcome_email",
    "subject": "Welcome to LMS",
    "content_type": "html",
    "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n        }\n        .container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f9f9f9;\n            border-radius: 8px;\n        }\n        .header {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 30px;\n            text-align: center;\n            border-radius: 8px 8px 0 0;\n        }\n        .content {\n            background-color: white;\n            padding: 30px;\n            border-radius: 0 0 8px 8px;\n        }\n        .welcome-text {\n            font-size: 20px;\n            color: #667eea;\n            margin: 20px 0;\n        }\n        .button {\n            display: inline-block;\n            background-color: #667eea;\n            color: white;\n            padding: 12px 30px;\n            text-decoration: none;\n            border-radius: 5px;\n            margin: 20px 0;\n        }\n        .features {\n            background-color: #f9f9f9;\n            padding: 20px;\n            border-radius: 5px;\n            margin: 20px 0;\n        }\n        .footer {\n            text-align: center;\n            padding: 20px;\n            font-size: 12px;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class='container'>\n        <div class='header'>\n            <h1>Welcome to LMS! 🎓</h1>\n        </div>\n        <div class='content'>\n            <p>Hello {{ user_name }},</p>\n            \n            <p class='welcome-text'>Your account has been created successfully!</p>\n            \n            <p>We're excited to have you join our learning management system. Get started by verifying your email and exploring the platform.</p>\n            \n            <div class='features'>\n                <h3>What you can do:</h3>\n                <ul>\n                    <li>📚 Access course materials and resources</li>\n                    <li>📝 Submit assignments and participate in discussions</li>\n                    <li>📊 Track your progress and grades</li>\n                    <li>💬 Connect with instructors and classmates</li>\n                    <li>⚙️ Customize your profile and preferences</li>\n                </ul>\n            </div>\n            \n            <p><strong>Next steps:</strong></p>\n            <ol>\n                <li>Verify your email by entering the OTP sent to this address</li>\n                <li>Complete your profile information</li>\n                <li>Browse available courses</li>\n                <li>Start learning!</li>\n            </ol>\n            \n            <p>If you have any questions or need help getting started, please don't hesitate to contact our support team.</p>\n            \n            <p>Happy learning!<br>LMS Team</p>\n        </div>\n        <div class='footer'>\n            <p>&copy; 2026 LMS. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
    "enabled": true
  },
  {
    "name": "two_factor_otp",
    "subject": "Two-Factor Authentication Code",
    "content_type": "html",
    "content": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n        }\n        .container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n            background-color: #f9f9f9;\n            border-radius: 8px;\n        }\n        .header {\n            background-color: #E91E63;\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 8px 8px 0 0;\n        }\n        .content {\n            background-color: white;\n            padding: 30px;\n            border-radius: 0 0 8px 8px;\n        }\n        .otp-box {\n            background-color: #f0f0f0;\n            border: 2px solid #E91E63;\n            padding: 15px;\n            text-align: center;\n            margin: 20px 0;\n            border-radius: 5px;\n        }\n        .otp-code {\n            font-size: 32px;\n            font-weight: bold;\n            color: #E91E63;\n            letter-spacing: 2px;\n        }\n        .security-notice {\n            background-color: #fff3cd;\n            border: 1px solid #ffeeba;\n            color: #856404;\n            padding: 10px;\n            border-radius: 5px;\n            margin: 15px 0;\n        }\n        .footer {\n            text-align: center;\n            padding: 20px;\n            font-size: 12px;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class='container'>\n        <div class='header'>\n            <h1>🔐 Two-Factor Authentication</h1>\n        </div>\n        <div class='content'>\n            <p>Hello {{ user_name }},</p>\n            \n            <p>You have enabled two-factor authentication for your account. Use the verification code below to complete your login:</p>\n            \n            <div class='otp-box'>\n                <p style='margin: 0; color: #666; font-size: 14px; margin-bottom: 10px;'>Your 2FA Code</p>\n                <div class='otp-code'>{{ otp }}</div>\n            </div>\n            \n            <div class='security-notice'>\n                <strong>Security Alert:</strong> Enter this code in your login screen. This code will expire in 10 minutes.\n            </div>\n            \n            <p><strong>Important:</strong></p>\n            <ul>\n                <li>Do not share this code with anyone, not even LMS staff</li>\n                <li>This code expires in 10 minutes</li>\n                <li>If you didn't initiate this login, please secure your account immediately</li>\n                <li>Enable notifications to be alerted of login attempts</li>\n            </ul>\n            \n            <p>For security reasons:</p>\n            <ul>\n                <li>Use strong, unique passwords</li>\n                <li>Enable two-factor authentication</li>\n                <li>Keep your recovery codes safe</li>\n                <li>Report suspicious activity immediately</li>\n            </ul>\n            \n            <p>If you have any security concerns, please contact our support team immediately.</p>\n            \n            <p>Best regards,<br>LMS Team</p>\n        </div>\n        <div class='footer'>\n            <p>&copy; 2026 LMS. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>",
    "enabled": true
  }
]