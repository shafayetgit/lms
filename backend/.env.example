# ============================================================================
# LMS Backend Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# ============================================================================

# ============================================================================
# DATABASE & CACHE
# ============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lms_db

# Redis connection for OTP storage and caching
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# CELERY (BACKGROUND TASKS)
# ============================================================================
# Enable Celery enqueue from API process
CELERY_ENABLED=False

# Broker / backend (defaults to REDIS_URL if omitted)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Timezone for Celery beat schedules
CELERY_TIMEZONE=UTC

# Development option: execute tasks locally (no broker needed)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# ============================================================================
# JWT & SECURITY
# ============================================================================
# Secret key for signing JWT tokens (change this in production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# APPLICATION
# ============================================================================
DEBUG=True
APP_TITLE=LMS Backend
FRONTEND_URL=http://localhost:3000


# ============================================================================
# OTP SETTINGS
# ============================================================================
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================================
# SMS CONFIGURATION (Twilio)
# ============================================================================
# SMS provider: 'twilio' or 'vonage'
SMS_PROVIDER=twilio

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ============================================================================
TWO_FA_ENABLED=True
TOTP_WINDOW=1

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================
# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback/google

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback/github

# ============================================================================
# LOGIN & SECURITY POLICIES
# ============================================================================
# Account lockout after failed login attempts
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_LOCKOUT_MINUTES=15

# ============================================================================
# PASSWORD POLICY
# ============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL_CHARS=True
